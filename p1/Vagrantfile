Vagrant.configure("2") do |config|
    config.vm.box = "Rocky_10"
    config.vm.box_url = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox-10.2-20260525.0.x86_64.vagrant.virtualbox.box"

    config.vm.define "kkraftS" do |m|
        m.vm.hostname = "kkraftS"
        m.vm.network "private_network", ip: "192.168.56.110"
        m.vm.provider "virtualbox" do |v|
            v.memory = 2048
            v.cpus = 1
            v.name = "kkraftS"
        end
        m.vm.provision "shell", path: "scripts/install_server.sh"
    end

    config.vm.define "kkraftSW" do |m|
        m.trigger.before :up do |t|
            t.name = "conf"
            t.run = { path: "scripts/get_config.sh" }
        end
        m.vm.hostname = "kkraftSW"
        m.vm.network "private_network", ip: "192.168.56.111"
        m.vm.provider "virtualbox" do |v|
            v.memory = 1024
            v.cpus = 1
            v.name = "kkraftSW"
        end
        m.vm.provision "shell", path: "scripts/install_agent.sh"
    end
end
